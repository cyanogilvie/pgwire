if {"bench" ni [info commands bench]} {
	package require bench
	namespace import bench::*
}

package require pgwire

source [file join [file dirname [file normalize [info script]]] common.tcl]

proc make_tdbc_pgwire_stmts {} { #<<<
	variable stmts
	variable q
	package require tdbc::pgwire
	if {[info commands tdbc_pgwire] eq ""} {
		tdbc::pgwire::connection create tdbc_pgwire -host db -db pagila -user postgres -password insecure
		dict set stmts tdbc_pgwire	[tdbc_pgwire prepare $q]
	}
}

#>>>
proc make_tdbc_postgres_stmts {} { #<<<
	variable stmts
	variable q
	package require tdbc::postgres
	if {[info commands tdbc_postgres] eq ""} {
		tdbc::postgres::connection create tdbc_postgres -host db -db pagila -user postgres -password insecure
		dict set stmts tdbc_postgres	[tdbc_postgres prepare $q]
	}
}

#>>>
proc destroy_stmts {} { #<<<
	variable stmts
	dict for {k v} $stmts {
		if {[info object isa object $v]} {
			$v destroy
		}
	}
}

#>>>

# allrows
bench tdbcpgwire-1.1 {prepared statement allrows, 1 row, 1 column} -setup { #<<<
	variable film_id	286
	variable q			{select title from film where film_id=:film_id}

	save_acc
	make_tdbc_pgwire_stmts
	make_pgwire_lo
} -transform {
	* {script {return "variable stmts; variable film_id; variable q; $script"}}
} -combinations {
	*	{%acc% {tcl c}}
} -deps {
	*_tcl			disable_acc
	*_c				try_force_acc
	{}				restore_acc
	tdbc_postgres	make_tdbc_postgres_stmts
} -compare {
	tdbc_pgwire_%acc%	{ [dict get $stmts tdbc_pgwire] allrows }
	pgwire_%acc%		{ pgwire_lo allrows $q }
	tdbc_postgres		{ [dict get $stmts tdbc_postgres] allrows }
} -cleanup {
	destroy_stmts
	restore_acc
} -result {{title {ENOUGH RAGING}}}
#>>>
bench tdbcpgwire-1.2 {prepared statement allrows, all rows, 1 column} -setup { #<<<
	variable q			{select film_id from film}

	save_acc
	make_tdbc_pgwire_stmts
	make_pgwire_lo
} -transform {
	* {script {return "variable stmts; variable q; $script"}}
} -combinations {
	*	{%acc% {tcl c}}
} -deps {
	*_tcl			disable_acc
	*_c				try_force_acc
	{}				restore_acc
	tdbc_postgres	make_tdbc_postgres_stmts
} -compare {
	tdbc_pgwire_%acc%	{ foreach row [[dict get $stmts tdbc_pgwire] allrows]   {incr idsum [dict get $row film_id]}; set idsum }
	pgwire_%acc%		{ foreach row [pgwire_lo allrows $q]                    {incr idsum [dict get $row film_id]}; set idsum }
	tdbc_postgres		{ foreach row [[dict get $stmts tdbc_postgres] allrows] {incr idsum [dict get $row film_id]}; set idsum }
} -cleanup {
	destroy_stmts
	restore_acc
} -result 500500
#>>>
