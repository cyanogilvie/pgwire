#>>>

bench tdbcpgwire-22.1 {resultset allrows, many rows, many columns} -setup { #<<<
	variable q		{select * from film}

	save_acc
	make_tdbc_pgwire_stmts
	make_pgwire_lo
} -deps {
	tdbc_postgres	make_tdbc_postgres_stmts
} -transform {
	* {script {return "variable stmts; $script"}}
} -combinations {
	* {%driver% {pgwire postgres}}
} -compare {
	tdbc_%driver% {
		set res			{}
		set count		0
		set resultset	[[dict get $stmts tdbc_%driver%] execute]
		while {[$resultset nextdict row]} {
			incr count
			if {![dict exists $row film_id]} {
				::pgwire::log error "No film_id in row: ($row)"
				continue
			}
			if {[dict get $row film_id] == 286} {
				lappend res	[dict get $row title]
			}
		}
		list $count [$resultset rowcount] $res
	}
} -cleanup {
	destroy_stmts
	restore_acc
} -result {1000 1000 {{ENOUGH RAGING}}}
#>>>

