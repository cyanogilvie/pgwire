	tdbc_pgwire_%acc%	{ foreach row [[dict get $stmts tdbc_pgwire] allrows]   {incr idsum [dict get $row film_id]}; set idsum }
	pgwire_%acc%		{ foreach row [pgwire_lo allrows $q]                    {incr idsum [dict get $row film_id]}; set idsum }
	tdbc_postgres		{ foreach row [[dict get $stmts tdbc_postgres] allrows] {incr idsum [dict get $row film_id]}; set idsum }
} -cleanup {
	destroy_stmts
	restore_acc
} -result 500500
