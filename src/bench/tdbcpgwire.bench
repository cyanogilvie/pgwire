# foreaach
bench tdbcpgwire-2.1 {prepared statement foreach, 1 row, 1 column} -setup { #<<<
	variable film_id	286
	variable q			{select title from film where film_id=:film_id}

	save_acc
	make_tdbc_pgwire_stmts
	make_pgwire_lo
} -transform {
	* {script {return "variable stmts; variable film_id; variable q; $script"}}
} -combinations {
	*	{%acc% {tcl c}}
} -deps {
	*_tcl			disable_acc
	*_c				try_force_acc
	{}				restore_acc
	tdbc_postgres	make_tdbc_postgres_stmts
} -compare {
	tdbc_pgwire_%acc%	{ [dict get $stmts tdbc_pgwire]   foreach row {lappend rows $row}; set rows }
	pgwire_%acc%		{ pgwire_lo foreach row $q                    {lappend rows $row}; set rows }
	tdbc_postgres		{ [dict get $stmts tdbc_postgres] foreach row {lappend rows $row}; set rows }
} -cleanup {
	destroy_stmts
	restore_acc
} -result {{title {ENOUGH RAGING}}}
