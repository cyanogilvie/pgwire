bench pgwire-4.1 {foreach, large number of columns, dicts, vars} -setup { #<<<
	save_acc
	make_pgwire_lo
	variable q	{select * from film}
} -transform {
	* {script {return "variable q; $script"}}
} -deps {
	*_tcl			disable_acc
	*_c				try_force_acc
	{}				restore_acc
	*_uds_*			make_pgwire_uds
	tdbc_postgres	make_tdbc_postgres

} -combinations {
	pgwire_* {
		%fmt% {
			{vars	{%col(f)% {format {$%s} $f}}}
		}
	}
	* {
		%af%	{lo uds}
		%fmt% {
			{dicts	{%col(f)% {format {[dict get $row %s]} $f}}}
		}
		%acc%	{tcl c}
	}
} -compare {

	pgwire_%af%_%fmt%_%acc%     {
		set count 0
		pgwire_%af% foreach -as %fmt% row $q {
			incr count
			if {%col(film_id)% == 286} {
				set pickedtitle %col(title)%
			}
		}
		list $count $pickedtitle
	}

	tdbc_postgres {
		set count 0
		tdbc_postgres foreach -as dicts row $q {
			incr count
			if {[dict get $row film_id] == 286} {
				set pickedtitle [dict get $row title]
			}
		}
		list $count $pickedtitle
	}

} -cleanup {
	restore_acc
} -result {1000 {ENOUGH RAGING}}
#>>>
bench pgwire-5.1 {foreach, large number of columns vs foreach [allrows] vs vars} -setup { #<<<
	save_acc
	make_pgwire_lo
	variable q	{select * from film}
} -transform {
	* {script {return "variable q; $script"}}
} -deps {
	*_tcl				disable_acc
	*_c					try_force_acc
	{}					restore_acc
	*_uds_*				make_pgwire_uds
	tdbc_postgres_*		make_tdbc_postgres
} -combinations {
	pgwire_* {
		%af%	{lo uds}
		%method%	{
			{foreach	{%loop% {pgwire_%af% foreach -as dicts row $q}				%col(c)%	{format {[dict get $row %s]} $c} }}
			{allrows	{%loop% {foreach row [pgwire_%af% allrows -as dicts $q]}	%col(c)%	{format {[dict get $row %s]} $c} }}
			{vars		{%loop% {pgwire_%af% vars $q}								%col(c)%	{format {$%s} $c} }}
		}
		%acc%	{tcl c}
	}
	tdbc_* {
		%method%	{
			{foreach	{%loop% {tdbc_postgres foreach -as dicts row $q}			%col(c)%	{format {[dict get $row %s]} $c} }}
			{allrows	{%loop% {foreach row [tdbc_postgres allrows -as dicts $q]}	%col(c)%	{format {[dict get $row %s]} $c} }}
		}
	}
} -compare {

	pgwire_%af%_%method%_%acc% {
		set count 0
		%loop% {
			incr count
			if {%col(film_id)% == 286} {
				set pickedtitle %col(title)%
			}
		}
		list $count $pickedtitle
	}

	tdbc_postgres_%method% {
		set count 0
		%loop% {
			incr count
			if {%col(film_id)% == 286} {
				set pickedtitle %col(title)%
			}
		}
		list $count $pickedtitle
	}

} -cleanup {
	restore_acc
} -result {1000 {ENOUGH RAGING}}
