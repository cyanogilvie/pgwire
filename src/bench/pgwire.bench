bench pgwire-7.2.1 {compile_ops} -setup { #<<<
	save_acc
	variable c_types {
		film_id int4 {}
		title text {}
		description text {}
		release_year int4 {}
		language_id int2 {}
		original_language_id int2 {}
		rental_duration int2 {}
		rental_rate text {}
		length int2 {}
		replacement_cost text {}
		rating text {}
		last_update text {}
		special_features text {}
		fulltext text {}
	}
	variable ops			"[::pgwire::build_ops dicts $c_types] "
	variable expecting		[expr {[llength $c_types] / 3}]
} -transform {
	* {script {return "variable c_types; variable ops; variable expecting; $script"}}
} -deps {
	*_tcl	disable_acc
	*_c		try_force_acc
	{}		restore_acc
} -combinations {
	* {%acc% {tcl c}}
} -compare {
	fresh_ops_%acc%			{ ::pgwire::compile_ops [::pgwire::build_ops dicts $c_types] $expecting }
	cached_ops_%acc%		{ ::pgwire::compile_ops $ops $expecting }
	cached_ops_string_%acc%	{ ::pgwire::compile_ops [string trim $ops] $expecting }
} -cleanup {
	restore_acc
} -result {}
#>>>
bench pgwire-7.2.2 {ops cache lookup} -setup { #<<<
	variable c_types {
		film_id int4 {}
		title text {}
		description text {}
		release_year int4 {}
		language_id int2 {}
		original_language_id int2 {}
		rental_duration int2 {}
		rental_rate text {}
		length int2 {}
		replacement_cost text {}
		rating text {}
		last_update text {}
		special_features text {}
		fulltext text {}
	}
	variable ops_cache_empty	{}
	variable ops_cache_miss		[dict create lists [::pgwire::build_ops lists $c_types]]
	variable ops_cache_hit		[dict create dicts [::pgwire::build_ops dicts $c_types]]
} -transform {
	* {script {return "variable c_types; variable ops_cache_empty; variable ops_cache_miss; variable ops_cache_hit; $script"}}
} -compare {
	ops_cache_empty_try {
		try {
			dict get $ops_cache_empty dicts
		} on ok ops {
		} trap {TCL LOOKUP DICT} {} {
			dict set ops_cache dicts [set ops [::pgwire::build_ops dicts $c_types]]
		}
		set ops
	}
	ops_cache_empty_catch {
		if {[catch {
			set ops	[dict get $ops_cache_empty dicts]
		}]} {
			dict set ops_cache dicts [set ops [::pgwire::build_ops dicts $c_types]]
		}
		set ops
	}
	ops_cache_empty_check {
		if {[dict exists $ops_cache_empty dicts]} {
			set ops	[dict get $ops_cache_empty dicts]
		} else {
			dict set ops_cache dicts [set ops [::pgwire::build_ops dicts $c_types]]
		}
		set ops
	}
	ops_cache_miss_try {
		try {
			dict get $ops_cache_miss dicts
		} on ok ops {
		} trap {TCL LOOKUP DICT} {} {
			dict set ops_cache dicts [set ops [::pgwire::build_ops dicts $c_types]]
		}
		set ops
	}
	ops_cache_miss_catch {
		if {[catch {
			set ops [dict get $ops_cache_miss dicts]
		}]} {
			dict set ops_cache dicts [set ops [::pgwire::build_ops dicts $c_types]]
		} 
		set ops
	}
	ops_cache_miss_check {
		if {[dict exists $ops_cache_miss dicts]} {
			set ops	[dict get $ops_cache_miss dicts]
		} else {
			dict set ops_cache dicts [set ops [::pgwire::build_ops dicts $c_types]]
		}
		set ops
	}
	ops_cache_hit_try {
		try {
			dict get $ops_cache_hit dicts
		} on ok ops {
		} trap {TCL LOOKUP DICT} {} {
			dict set ops_cache dicts [set ops [::pgwire::build_ops dicts $c_types]]
		}
		set ops
	}
	ops_cache_hit_catch {
		if {[catch {
			set ops	[dict get $ops_cache_hit dicts]
		}]} {
			dict set ops_cache dicts [set ops [::pgwire::build_ops dicts $c_types]]
		}
		set ops
	}
	ops_cache_hit_check {
		if {[dict exists $ops_cache_hit dicts]} {
			set ops	[dict get $ops_cache_hit dicts]
		} else {
			dict set ops_cache dicts [set ops [::pgwire::build_ops dicts $c_types]]
		}
		set ops
	}
} -result {op_int4_dicts op_text_dicts op_text_dicts op_int4_dicts op_int2_dicts op_int2_dicts op_int2_dicts op_text_dicts op_int2_dicts op_text_dicts op_text_dicts op_text_dicts op_text_dicts op_text_dicts}
#>>>
bench pgwire-7.3 {foreach_batch} -setup { #<<<
	make_pgwire_lo
	set params		{}
	variable vals	{}
	variable vars	{}
	foreach {k v} [get_batch_vars pgwire_lo {select * from film} 0 dicts] {
		lappend params	$k
		lappend vals	$v
		variable $k $v
		lappend vars $k
	}
	variable tcl_makerow_lambda [list [list datarow {*}$params] "variable ::pgwire::arr_fmt_cache; $tcl_makerow; set row"]
} -transform {
	* {script {variable vars; return "variable vals; variable tcl_makerow_lambda; [join [lmap v $vars {format {variable %s} $v}] {; }]; $script"}}
} -combinations {
	* {%nr% {{} _nr}}
} -compare {
	tcl_makerow {
		set acc		0
		set count	0
		foreach datarow $datarows {
			set row	[apply $tcl_makerow_lambda $datarow {*}$vals]
			try {
				incr count
				incr acc	[dict get $row film_id]
			} on break {} {
				set broken	1
				break
			} on continue {} {
			} on return {r o} {
				#::pgwire::log notice "foreach script caught return r: ($r), o: ($o)"
				set broken	1
				dict incr o -level 1
				dict set o -code return
				set rethrow	[list -options $o $r]
				break
			} on error {r o} {
				#::pgwire::log notice "foreach script caught error r: ($r), o: ($o)"
				set broken	1
				dict incr o -level 1
				set rethrow	[list -options $o $r]
				break
			}
		}
		if {[info exists rethrow]} {
			return {*}$rethrow
		}
		list $count $acc
	}
	c_foreach_batch%nr% {
		set acc		0
		set count	0
		::pgwire::c_foreach_batch%nr% row $ops $columns $tcl_encoding $datarows {
			incr count
			incr acc	[dict get $row film_id]
		} $delims
		list $count $acc
	}
} -result {1000 500500}
#>>>
bench pgwire-8.1 {vars, no script} -setup { #<<<
	save_acc
	make_pgwire_lo
} -combinations {
	* {
		%af%	{lo uds}
		%acc%	{tcl c}
	}
} -deps {
	*_tcl			disable_acc
	*_c				try_force_acc
	*_uds_*			make_pgwire_uds
	tdbc_postgres	make_tdbc_postgres
} -compare {
	pgwire_%af%_%acc% {
		pgwire_%af% vars {select title from film where film_id=286}
		set title
	}

	tdbc_postgres {
		lindex [tdbc_postgres allrows -as lists {select title from film where film_id=286}] 0 0
	}
} -cleanup {
	restore_acc
} -result {ENOUGH RAGING}
