if {"bench" ni [info commands bench]} {
	package require bench
	namespace import bench::*
}

package require pgwire

proc readfile fn { #<<<
	set h	[open $fn r]
	try {read $h} finally {close $h}
}

#>>>
proc get_batch_vars {db sql batchsize as} { #<<<
	set stmt_info	[$db prepare_extended_query $sql]
	dict with stmt_info {}
	# Sets:
	#	- $stmt_name: the name of the prepared statement (as known to the server)
	#	- $field_names:	the result column names and the local variables they are unpacked into
	#	- $build_params: lambda to run to gather the input params
	#	- $heat: how frequently this prepared statement has been used recently, relative to others

	set parameters	[apply $build_params]

	set max_rows_per_batch	$batchsize

	set ops	[::pgwire::build_ops $as $c_types]
	try {
		set rowbuffer	::rowbuffer_coro_get_batch_vars_[incr ::coro_seq]
		coroutine $rowbuffer $db rowbuffer_coro $stmt_name $rowbuffer $rformats $parameters $max_rows_per_batch $stmt_info
		lassign [$rowbuffer nextbatch] outcome details datarows

		list \
			ops				$ops \
			columns			$columns \
			tcl_encoding	[$db tcl_encoding] \
			datarows		$datarows \
			c_types			$c_types \
			delims			$delims \
			tcl_makerow		[$db tcl_makerow $as $c_types]
	} finally {
		if {[info exists rowbuffer] && [llength [info commands $rowbuffer]] > 0} {
			$rowbuffer destroy
		}
	}
}

#>>>

source [file join [file dirname [file normalize [info script]]] common.tcl]

bench pgwire-1.0 {select 1, simple_query_list} -setup { #<<<
	make_pgwire_lo
} -combinations {
	* {%af% {lo uds}}
} -deps {
	*_uds {make_pgwire_uds}
} -compare {
	pgwire_%af% {
		pgwire_%af% simple_query_list row {select 1} {set res [lindex $row 0]}
		set res
	}
} -result 1
#>>>
bench pgwire-1.1 {select 1} -setup { #<<<
	save_acc
	make_pgwire_lo
} -combinations {
	* {%af% {lo uds} %acc% {tcl c}}
} -deps {
	*_tcl			disable_acc
	*_c				try_force_acc
	*_uds_*			make_pgwire_uds
	tdbc_postgres	make_tdbc_postgres
} -compare {
	pgwire_%af%_%acc%	{ pgwire_%af% onecolumn {select 1} }
	tdbc_postgres		{ lindex [tdbc_postgres allrows -as lists {select 1}] 0 0 }
} -cleanup {
	restore_acc
} -result 1
#>>>
bench pgwire-1.2 {onecolumn} -setup { #<<<
	make_pgwire_lo
	save_acc
} -combinations {
	* {%af% {lo uds} %acc% {tcl c}}
} -deps {
	*_tcl			disable_acc
	*_c				try_force_acc
	*_uds_*			make_pgwire_uds
	tdbc_postgres	make_tdbc_postgres
} -compare {
	pgwire_%af%_%acc%	{ pgwire_%af% onecolumn {select title from film where film_id=286} }
	tdbc_postgres		{ lindex [tdbc_postgres allrows -as lists {select title from film where film_id=286}] 0 0 }
} -cleanup {
	restore_acc
} -result {ENOUGH RAGING}
#>>>
bench pgwire-1.3 {onecolumn, with param} -setup { #<<<
	save_acc
	make_pgwire_lo
	variable film_id	286
} -transform {
	* {script {return "variable film_id; $script"}}
} -combinations {
	* {%af% {lo uds} %acc% {tcl c}}
} -deps {
	*_tcl			disable_acc
	*_c				try_force_acc
	*_uds_*			make_pgwire_uds
	tdbc_postgres	make_tdbc_postgres
} -compare {
	pgwire_%af%_%acc%	{ pgwire_%af% onecolumn {select title from film where film_id=:film_id} }
	tdbc_postgres		{ lindex [tdbc_postgres allrows -as lists {select title from film where film_id=:film_id}] 0 0 }
} -cleanup {
	restore_acc
} -result {ENOUGH RAGING}
#>>>
bench pgwire-1.4 {sync} -setup { #<<<
	save_acc
	make_pgwire_lo
} -combinations {
	* {
		%af%	{lo uds}
		%acc%	{tcl c}
	}
} -deps {
	*_tcl		disable_acc
	*_c			try_force_acc
	*_uds_*		make_pgwire_uds
} -compare {
	pgwire_%af%_%acc%  { pgwire_%af% sync }
} -cleanup {
	restore_acc
} -result {}
#>>>
bench pgwire-2.1 {allrows, large number of columns, lists} -setup { #<<<
	save_acc
	make_pgwire_lo
	variable q		{select * from film}
} -transform {
	*	{script {return "variable q; $script"}}
} -deps {
	*_tcl			disable_acc
	*_c				try_force_acc
	{}				restore_acc
	tdbc_postgres	make_tdbc_postgres
	*_uds_*			make_pgwire_uds
} -combinations {
	* {
		%af%	{lo uds}
		%acc%	{tcl c}
	}

} -compare {
	pgwire_%af%_%acc%	{
		llength [pgwire_%af% allrows -as lists $q]
	}

	tdbc_postgres {
		llength [tdbc_postgres allrows -as lists $q]
	}

} -cleanup {
	restore_acc
} -result 1000
#>>>
bench pgwire-2.2 {allrows, large number of columns, lists and dicts} -setup { #<<<
	save_acc
	make_pgwire_lo
	variable q	{select * from film}
} -transform {
	*	{script {return "variable q; $script"}}
} -deps {
	*_tcl				disable_acc
	*_c					try_force_acc
	{}					restore_acc
	tdbc_*_postgres		make_tdbc_postgres
	*_uds_*				make_pgwire_uds
} -combinations {
	* {
		%fmt%	{lists dicts}
		%af%	{lo uds}
		%acc%	{tcl c}
	}
} -compare {
	pgwire_%fmt%_%af%_%acc%	{ llength [pgwire_%af%   allrows -as %fmt% $q] }
	tdbc_%fmt%_postgres		{ llength [tdbc_postgres allrows -as %fmt% $q] }
} -cleanup {
	restore_acc
} -result 1000
#>>>
bench pgwire-2.4 {allrows, one row, one column, lists and dicts} -setup { #<<<
	save_acc
	make_pgwire_lo
	variable q {select title from film where film_id=286}
} -transform {
	*	{script {return "variable q; $script"}}
} -deps {
	*_tcl				disable_acc
	*_c					try_force_acc
	{}					restore_acc
	*_uds_*				make_pgwire_uds
	tdbc_*_postgres		make_tdbc_postgres
} -combinations {
	* {
		%fmt%	{
			{lists	{%col(s)%	{return "lindex \[$s\] 0"}}}
			{dicts	{%col(s)%	{return "dict get \[$s\] title"}}}
		}
		%af%	{lo uds}
		%acc%	{tcl c}
	}
} -compare {
	pgwire_%fmt%_%af%_%acc%	{ %col({lindex [pgwire_%af%   allrows -as %fmt% $q] 0})% }
	tdbc_%fmt%_postgres		{ %col({lindex [tdbc_postgres allrows -as %fmt% $q] 0})% }
} -cleanup {
	restore_acc
} -result {ENOUGH RAGING}
#>>>
bench pgwire-3.1 {foreach, large number of columns} -setup { #<<<
	save_acc
	make_pgwire_lo
	variable q	{select * from film}
} -transform {
	*	{script {return "variable q; $script"}}
} -deps {
	*_tcl				disable_acc
	*_c					try_force_acc
	{}					restore_acc
	*_uds_*				make_pgwire_uds
	tdbc_postgres_*		make_tdbc_postgres

} -combinations {
	* {
		%af%	{uds lo}
		%fmt% {
			{dicts {%col(f)% {format {[dict get $row %s]} $f}}}
			{lists {%col(f)% {format {[lindex $row 0]}}}}
		}
		%acc%	{tcl c}
	}
	pgwire_* {
		%fmt% {
			{vars	{%col(f)% {format {$%s} $f}}}
		}
	}
} -compare {

	pgwire_%af%_%fmt%_%acc% {
		set idsum	0
		pgwire_%af% foreach -as %fmt% row $q {
			incr idsum	%col(film_id)%
		}
		set idsum
	}

	tdbc_postgres_%fmt% {
		set idsum	0
		tdbc_postgres foreach -as %fmt% row $q {
			incr idsum	%col(film_id)%
		}
		set idsum
	}

} -cleanup {
	restore_acc
} -result 500500
