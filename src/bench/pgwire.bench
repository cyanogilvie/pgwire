#>>>
bench pgwire-6.1 {transactions: simple_query_list vs extended_query} -setup { #<<<
	save_acc
	make_pgwire_lo
} -combinations {
	* {
		%af%	{uds lo}
		%acc%	{tcl c}
	}
} -deps {
	*_tcl				disable_acc
	*_c					try_force_acc
	{}					restore_acc
	*_uds_*				make_pgwire_uds
	tdbc_postgres		make_tdbc_postgres
} -compare {
	pgwire_simple_query_list_%af%_%acc% {
		set res	{}
		pgwire_%af% simple_query_list r begin {}
		lappend res [pgwire_%af% transaction_status]
		pgwire_%af% simple_query_list r rollback {}
		lappend res [pgwire_%af% transaction_status] [pgwire_%af% ready_for_query]
		set res
	}
	pgwire_methods_%af%_%acc% {
		set res	{}
		pgwire_%af% begintransaction
		lappend res [pgwire_%af% transaction_status]
		pgwire_%af% rollback
		lappend res [pgwire_%af% transaction_status] [pgwire_%af% ready_for_query]
		set res
	}
	tdbc_postgres	{
		set res	{}
		tdbc_postgres begintransaction
		lappend res T
		tdbc_postgres rollback
		lappend res I 1
		set res
	}
} -cleanup {
	restore_acc
} -result {T I 1}
#>>>
bench pgwire-7.1 {makerow} -setup { #<<<
	make_pgwire_lo
	variable c_types {
		film_id int4 {}
		title text {}
		description text {}
		release_year int4 {}
		language_id int2 {}
		original_language_id int2 {}
		rental_duration int2 {}
		rental_rate text {}
		length int2 {}
		replacement_cost text {}
		rating text {}
		last_update text {}
		special_features text {}
		fulltext text {}
	}
	variable ops_list		{op_int4_lists op_text_lists op_text_lists op_int4_lists op_int2_lists op_int2_lists op_int2_lists op_text_lists op_int2_lists op_text_lists op_text_lists op_text_lists op_text_lists op_text_lists}
	variable ops_dict		{op_int4_dicts op_text_dicts op_text_dicts op_int4_dicts op_int2_dicts op_int2_dicts op_int2_dicts op_text_dicts op_int2_dicts op_text_dicts op_text_dicts op_text_dicts op_text_dicts op_text_dicts}
	variable ops_vars		[::pgwire::build_ops vars $c_types]
	variable columns 		{film_id title description release_year language_id original_language_id rental_duration rental_rate length replacement_cost rating last_update special_features fulltext}
	variable tcl_encoding	utf-8
	variable delims		[lrepeat [llength $columns] {}] 
	variable datarow	[binary decode hex ]
	variable tcl_makerow_lists	[list {datarow ops_list ops_dict columns tcl_encoding c_types delims} "variable ::pgwire::arr_fmt_cache\n[pgwire_lo tcl_makerow lists $c_types]\nlindex \$row 1"]
	variable tcl_makerow_dicts	[list {datarow ops_list ops_dict columns tcl_encoding c_types delims} "variable ::pgwire::arr_fmt_cache\n[pgwire_lo tcl_makerow dicts $c_types]\ndict get \$row title"]
	variable tcl_makerow_vars	[list {datarow ops_list ops_dict columns tcl_encoding c_types delims} "variable ::pgwire::arr_fmt_cache\n[pgwire_lo tcl_makerow vars $c_types]"]
	variable nsvars	{tcl_makerow_lists tcl_makerow_dicts tcl_makerow_vars datarow ops_list ops_dict ops_vars columns tcl_encoding c_types delims}
} -transform {
	*	{script {variable nsvars; return "[join [lmap v $nsvars {format {variable %s} $v}] {;}]; $script"}}
} -combinations {
	tcl_*	{%fmt% {lists dicts}}
} -compare {
	tcl_makerow_%fmt% {
		apply $tcl_makerow_%fmt% $datarow $ops_list $ops_dict $columns $tcl_encoding $c_types $delims
	}
	tcl_makerow_vars {
		apply {args {
			apply {*}$args
		}} $tcl_makerow_vars $datarow $ops_list $ops_dict $columns $tcl_encoding $c_types $delims
		set title
	}

	c_makerow2_lists {
		lindex [::pgwire::c_makerow2 $ops_list $columns $tcl_encoding $datarow $delims] 1
	}
	c_makerow2_dicts {
		dict get [::pgwire::c_makerow2 $ops_dict $columns $tcl_encoding $datarow $delims] title
	}
	c_makerow2_vars {
		::pgwire::c_makerow2 $ops_vars $columns $tcl_encoding $datarow $delims
		set title
	}
} -result {ZORRO ARK}
#>>>
bench pgwire-7.2 {build_ops} -setup { #<<<
	save_acc
	variable c_types {
		film_id int4 {}
		title text {}
		description text {}
		release_year int4 {}
		language_id int2 {}
		original_language_id int2 {}
		rental_duration int2 {}
		rental_rate text {}
		length int2 {}
		replacement_cost text {}
		rating text {}
		last_update text {}
		special_features text {}
		fulltext text {}
	}
} -transform {
	*	{script {return "variable c_types; $script"}}
} -combinations {
	*	{
		%fmt%	{dicts lists vars}
		%acc%	{tcl c}
	}
} -deps {
	*_tcl		disable_acc
	*_c			try_force_acc
	{}			restore_acc
} -compare {
	%fmt%_%acc% { llength [::pgwire::build_ops %fmt% $c_types] }
} -cleanup {
	restore_acc
} -result 14
